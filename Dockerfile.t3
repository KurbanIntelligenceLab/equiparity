# syntax=docker/dockerfile:1
# ==============================================================
# T3 + H-1 overlay image — the N_zero learning-curve sweep and the epoch-curve retrains.
#
# Layers on top of the published training image (Dockerfile.e1 pattern): the base already has
# the locked venv, CUDA/torch, and ssh/tmux/rsync. This overlay adds the per-epoch-OOD
# instrumented trainers (src), the T3/H-1 grid generators (scripts + the achieved-N record in
# results/), the configs tree, and the three N_zero training sets. No apt, no network.
#
#   docker build -f Dockerfile.t3 --build-arg BASE=johnpolat/equiparity:nequip \
#       -t johnpolat/equiparity:t3-nequip .
#   docker build -f Dockerfile.t3 --build-arg BASE=johnpolat/equiparity:mace \
#       -t johnpolat/equiparity:t3-mace .
# ==============================================================

ARG BASE=johnpolat/equiparity:nequip
FROM ${BASE}

WORKDIR /workspace

# Instrumented trainers (ood_false_flag_history) + grid generators + achieved-N record.
COPY src ./src
COPY scripts ./scripts
COPY configs ./configs
COPY results/t3_augmentation_sets.json ./results/t3_augmentation_sets.json
COPY data/manifests ./data/manifests

# The N_zero training sets (nested: 250 subset of E1's 1000 subset of 4000 subset of 16000).
COPY data/raw/mp/mp_piezoelectric_augmented_n*_processed.npz ./data/raw/mp/
COPY data/splits/mp_piezoelectric_augmented_n*_split.npz data/splits/mp_piezoelectric_split.npz ./data/splits/

# Fail the build, not the rented GPU, if the instrumentation or the data went missing.
RUN python - <<'EOF'
import dataclasses
import json
import pathlib

import numpy as np
import yaml

from equiparity.training.nequip_tensor import TensorRunResult

fields = {f.name for f in dataclasses.fields(TensorRunResult)}
assert "ood_false_flag_history" in fields, fields
sets = json.loads(pathlib.Path("results/t3_augmentation_sets.json").read_text())["sets"]
for key, rec in sets.items():
    n = rec["n_achieved"]
    d = np.load(f"data/raw/mp/mp_piezoelectric_augmented_{key}_processed.npz")
    assert len(d["ids"]) == 3312 + n, (key, len(d["ids"]))
    s = np.load(f"data/splits/mp_piezoelectric_augmented_{key}_split.npz")
    assert len(s["train"]) == 2649 + n, (key, len(s["train"]))
c = yaml.safe_load(pathlib.Path("configs/t3/nequip_piezoelectric_so3_n250_seed0.yaml").read_text())
assert c["training"]["target_scale"] == 0.749134 and c["parity"] == "so3", c
h = yaml.safe_load(
    pathlib.Path("configs/h1curve/nequip_piezoelectric_so3_epochcurve_seed0.yaml").read_text()
)
assert h["dataset"] == "mp_piezoelectric_epochcurve", h
print("T3 overlay OK:", {k: v["n_achieved"] for k, v in sets.items()})
EOF

CMD ["bash", "-c", "echo 'equiparity T3/H-1 overlay. Run: equiparity run configs/t3/<name>.yaml'"]
