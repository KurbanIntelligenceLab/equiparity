# syntax=docker/dockerfile:1
# ==============================================================
# E1 overlay image — the augmentation-rebuttal grid.
#
# Layers on top of the already-published training image rather than rebuilding it: the base already
# has the locked venv, CUDA/torch, and ssh/tmux/rsync. This overlay only adds the augmented dataset,
# the E1 configs/generator, and the current src (which carries `training.target_scale`).
#
# No `apt-get` here on purpose. Rebuilding the base needs Debian mirrors, and the docker daemon on
# this host cannot resolve DNS inside build containers ("Temporary failure resolving
# deb.debian.org") even though the host can. An overlay needs no network at all.
#
#   docker build -f Dockerfile.e1 --build-arg BASE=johnpolat/equiparity:nequip \
#       -t johnpolat/equiparity:e1-nequip .
#   docker build -f Dockerfile.e1 --build-arg BASE=johnpolat/equiparity:mace \
#       -t johnpolat/equiparity:e1-mace .
# ==============================================================

ARG BASE=johnpolat/equiparity:nequip
FROM ${BASE}

WORKDIR /workspace

# Current source: adds TrainingParams.target_scale, honoured by the three tensor trainers.
COPY src ./src
COPY scripts ./scripts
COPY configs ./configs

# The augmented training set (real piezo tensors + 1000 centrosymmetric crystals labelled zero)
# and its split. The OOD evaluation npz are already baked into the base.
COPY data/raw/mp/mp_piezoelectric_augmented_processed.npz ./data/raw/mp/
COPY data/splits/mp_piezoelectric_augmented_split.npz ./data/splits/
COPY data/manifests ./data/manifests

# Fail the build, not the rented GPU, if the frozen scale or the configs went missing.
RUN python -c "\
import numpy as np, yaml, pathlib;\
d = np.load('data/raw/mp/mp_piezoelectric_augmented_processed.npz');\
assert len(d['ids']) == 4312, len(d['ids']);\
s = np.load('data/splits/mp_piezoelectric_augmented_split.npz');\
assert len(s['train']) == 3649, len(s['train']);\
c = yaml.safe_load(pathlib.Path('configs/e1/nequip_piezoelectric_so3_aug_seed0.yaml').read_text());\
assert c['training']['target_scale'] == 0.749134, c['training'];\
assert c['parity'] == 'so3';\
print('E1 overlay OK:', len(d['ids']), 'structures,', len(s['train']), 'train')"

CMD ["bash", "-c", "echo 'equiparity E1 overlay. Run: equiparity run configs/e1/<name>.yaml'"]
