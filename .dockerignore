# Keep the build context small: the image installs from uv.lock; the 62 MB processed npz are
# baked in (COPYed in the Dockerfile), but the 7 GB .venv and the ~670 MB raw QM9 xyz are not.

# Environments and caches
.venv/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Raw datasets are large and only needed for one-time prep — exclude them, but KEEP the small
# processed npz (the Dockerfile bakes them in). data/manifests + data/splits are committed and COPYed.
data/raw/qm9/xyz/
data/raw/qm9/*.tar.bz2
data/raw/qm9/uncharacterized.txt
outputs/

# Git history and CI (not needed in the image; the sha is passed at build/run time)
.git/
.github/

# Dev-only and editor cruft
tests/
docs/
.claude/
scratchpad/
.vscode/
.idea/
.env
*.log
.DS_Store
