# OS metadata. Not present in the upstream template and absent from this repo's history,
# so a Finder visit would otherwise add .DS_Store files to the submission branch.
.DS_Store
._*
Thumbs.db

# equiparity: research artifacts (CODING_RULES.md §A — never commit raw data or outputs)
/outputs/
/outputs_cloud/
# Written as /data/raw/** rather than /data/raw/: the directory form makes git skip the
# directory entirely, so the `!` exceptions below for the processed MP archives could never
# take effect. The glob form ignores the contents while still descending.
/data/raw/**
/data/**/*.lmdb
/data/**/*.h5
/data/**/*.tar.gz
*.pt
*.ckpt
*.parquet
!data/manifests/**
!data/splits/**
# Jd.pt is not a trained weight: it is the Wigner-D rotation table that ships with the
# vendored EquiformerV2 source (22 KB, MIT). wigner.py loads it at import, so every
# EquiformerV2 arm and its verification gate fail without it.
!src/equiparity/models/equiformer_v2/Jd.pt
# The processed Materials Project archives ARE tracked (6.7 MB total across six files): they
# are the exact
# inputs the evaluation reads, their SHA-256 digests are recorded in the manifests above,
# and no public endpoint returns these derived arrays. QM9 stays out: its 133,885 .xyz
# files and the source tarball are a redistribution of a public CC0 dataset that
# data/manifests/qm9.yaml already pins by content hash, and scripts/prepare_qm9.py
# rebuilds them.
!data/raw/mp/
!data/raw/mp/*.npz
!data/raw/mp_dryrun/
!data/raw/mp_dryrun/*.npz

# H1/H2 external source checkouts (pinned shas recorded in reports; code not committed)
third_party/

# frozen-backbone feature caches (regenerable via scripts/t4_cache_*.py; hundreds of MB)
results/t4/*_train.npz
results/t4/*_val.npz
results/t4/*_test.npz
results/t4/*_ood.npz

# ======================================================================================
# MANUSCRIPT
# ======================================================================================
# The manuscript is not part of this repository: it is submitted through the journal, and its
# working directory stays local (see /docs/draft_new/ and /docs/draft/ at the end of this
# file). LaTeX build products are ignored globally so a local compile never dirties the tree.

# LaTeX build products. Regenerated by every compile.
*.aux
*.out
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.lof
*.lot
*.run.xml
*.bcf
*.bbl
*.pdf


# NOTE ON *.log: the Django-derived rule far above ignores every .log, which is correct
# for docs/draft/main.log and sn-supplementary.log (pdfTeX output). It would also silently
# drop a harvested run log that is DATA rather than a build product. No such file exists in
# the tree today; if one is added under results/, name it back with an explicit `!` rule.

# Review screenshots. Screen captures taken while reading proofs: every value they depict is
# read from results/ records by the validators, so they are never provenance. The directory
# recurs naturally during revision, hence a rule rather than a one-time cleanup.
/rev_check/

# Retired material staged by a repo consolidation. Mirrors the repository layout, so any
# group is restored by moving its path back; see to_be_deleted/MANIFEST.md. Never pushed.
/to_be_deleted/

# Interim-material archives produced by repo cleanups
archive_interim_*.zip
archive_interim_*_manifest.txt

/docs/draft/
/docs/draft_new/
# Seventeen scripts write per-experiment Markdown reports here (analyze_results.py, the e*,
# f*, h* and t* drivers). Every number in them is read from a results/ record, so they are
# regenerated output, not provenance.
/docs/results/
/.claude/
